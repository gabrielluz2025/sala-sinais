# =============================================================================
# PERFIL MODO REAL — NÃO copie para .env até o preflight passar na conta REAL
#
# 1) MT5 aberto e logado na conta REAL (não demo)
# 2) Rode: python -m engine.scripts.preflight_live
# 3) Veredito deve ser "READY for live" (exit 2) ou "SAFE for paper" se ainda testando
# 4) Copie apenas as linhas necessárias para seu .env (não substitua WEBHOOK_SECRET etc.)
# =============================================================================

SIGNAL_MODE=live
LIVE_TRADING=true
# NUNCA use true em produção — só para testar ordens em demo com LIVE_TRADING=true
ALLOW_DEMO_LIVE=false

# Símbolo exato do WIN no Market Watch (ex.: WIN$, WINJ26)
MT5_SYMBOL=WIN$

# Taxas para PnL líquido realista (ajuste conforme sua corretora / RLP)
# RLP ativo costuma zerar corretagem; taxa B3 por contrato ida+volta ~R$ 0,28
B3_FEE_PER_CONTRACT_ROUND=0.28
BROKER_FEE_PER_CONTRACT=0
