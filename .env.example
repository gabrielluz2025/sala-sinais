# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/sala_sinais.db
WEBHOOK_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:8080

# --- Engine ---
# Modos: simulation (sem MT5) | paper_mt5 (MT5 + ordens demo com EXECUTE_ON_DEMO) | live_mt5 (conta real)
ENGINE_MODE=simulation
API_BASE_URL=http://127.0.0.1:8000
MT5_PATH=
# Clear (recomendado): MT5_PATH=C:\Program Files\Clear Investimentos MT5 Terminal\terminal64.exe
MT5_SYMBOL=WIN$
MT5_TIMEFRAME=M1
STRATEGY_ID=win_scalp_v1
POLL_INTERVAL_SEC=5

# Risco
MAX_CONTRACTS=1
TRADE_START_HOUR=10
TRADE_END_HOUR=17
SIGNAL_COOLDOWN_SEC=60
STOP_POINTS=80
TARGET_POINTS=120

# paper = só registra sinal | live = pode enviar ordem (demo ou real conforme flags abaixo)
SIGNAL_MODE=paper
LIVE_TRADING=false
# --- Demo Clear / paper_mt5 (ordens na conta demo do MT5) ---
# ENGINE_MODE=paper_mt5
# SIGNAL_MODE=live
# LIVE_TRADING=false
# AUTO_EXECUTE_ORDERS=true
# EXECUTE_ON_DEMO=true
# Ver docs/MT5_EXECUCAO.md
AUTO_EXECUTE_ORDERS=true
EXECUTE_ON_DEMO=true
# Testes à noite (fora 10h–17h BRT): ignora janela B3 em paper_mt5 demo. Desligue em LIVE_TRADING=true.
B3_IGNORE_SESSION_HOURS=true
# Aprendizado noturno (Sala-Sinais.bat opção 7): study + sinais sim sem MT5
OVERNIGHT_LEARNING=false
OVERNIGHT_STUDY_INTERVAL_SEC=300
# Agente estuda library/articles sozinho (marca progresso + nível; sem LLM; só leitura .md, sem ordens)
# 24h enquanto a API estiver no ar — independente de pregão B3, ENGINE_MODE live/paper/sim e OVERNIGHT_LEARNING
AGENT_AUTO_STUDY_LIBRARY=true
AGENT_STUDY_INTERVAL_SEC=300
# Aprende com trades fechados: insights + guardas soft no motor (não bloqueia boleta manual)
AUTO_LEARN_FROM_TRADES=true

# Simulação (ENGINE_MODE=simulation)
SIM_SIGNAL_INTERVAL_SEC=120
SIM_BASE_PRICE=125000
SIM_RESPECT_RISK_HOURS=false
SIM_DEMO_SIGNALS=true
# true = permite LIVE_TRADING em conta demo (só testes; ver docs/MODO_REAL.md)
ALLOW_DEMO_LIVE=false

# --- PnL estimado (WIN) ---
# Valor por ponto/contrato: R$ 0,20 (fixo no código — ver docs/ROADMAP.md)
# Taxa B3 por contrato (ida+volta), padrão ~R$ 0,28; RLP costuma zerar corretagem
B3_FEE_PER_CONTRACT_ROUND=0.28
BROKER_FEE_PER_CONTRACT=0
# Ações: emolumentos estimados sobre volume (ida+volta); 0 = desliga e usa só taxa por contrato
EQUITY_EMOLUMENT_PCT=0.0003
# IR day trade estimado no painel (20% sobre lucro líquido operacional — educativo, não retido)
DAY_TRADE_IR_RATE=0.20

# Cache do feed RSS de notícias (segundos)
NEWS_CACHE_SEC=600

# Biblioteca — ingestão de digest RSS → library/news/ (vírgula; ver docs/BIBLIOTECA_ESCALA.md e BIBLIOTECA_FONTES_EXTERNAS.md)
# LIBRARY_NEWS_RSS_URLS=https://www.infomoney.com.br/feed/,https://feeds.folha.uol.com.br/emcimadamedia/rss091.xml
# Ingestão automática enquanto a API estiver no ar (0 = desligado; ex.: 6 = a cada 6 horas)
# LIBRARY_AUTO_INGEST_HOURS=6
# APIs opcionais (scripts/ingest_external_finance.py e job da API)
# FINNHUB_API_KEY=
# NEWSAPI_KEY=
